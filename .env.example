# ==========================================
# Database Configuration (MySQL)
# ==========================================
DATABASE_URL="mysql://root:root@127.0.0.1:3306/hrms"

# ==========================================
# Authentication & Security
# ==========================================
# Secret key used for signing JWT tokens (generate using: openssl rand -hex 32)
JWT_SECRET="replace_with_a_secure_jwt_secret_key_min_32_characters"

# Token used for initial Super Admin setup (/setup/super-admin or /api/setup/super-admin)
SUPER_ADMIN_SETUP_TOKEN="replace_with_a_secure_setup_token_here"

# Secret used to secure automated cron tasks (e.g. auto-checkout / attendance sync)
CRON_SECRET="replace_with_a_secure_cron_secret_key_here"

# ==========================================
# Application URLs & Environment
# ==========================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# ==========================================
# Super Admin Seed Configuration (Optional)
# ==========================================
SUPERADMIN_EMAIL="superadmin@example.com"
SUPERADMIN_PASSWORD="StrongPassword123!"
SUPERADMIN_PREFIX="superadmin_"
SUPERADMIN_DOMAIN="example.com"

# ==========================================
# Company Configuration
# ==========================================
# Relative path to company configuration file (defaults to config/company.yaml)
COMPANY_CONFIG_PATH="config/company.yaml"

# ==========================================
# Email / SMTP Configuration (Nodemailer)
# ==========================================
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
EMAIL_USER="info@example.com"
EMAIL_PASS="your_email_password"

# ==========================================
# AI & Document Intelligence (Resume & JD Parsing)
# ==========================================
# Google Gemini API Key (used for resume parsing, candidate scoring, and JD analysis)
GEMINI_API_KEY=""

# Groq API Key (used for fast LLM inference)
GROQ_API_KEY=""

# OpenAI API Key (optional)
OPENAI_API_KEY=""

# HR Assistant Bot Mode: RULE_BASED or LLM
BOT_MODE="RULE_BASED"

# ==========================================
# AWS Services (Optional: Textract / Bedrock)
# ==========================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
