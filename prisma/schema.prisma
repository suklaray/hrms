generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model company {
  id                  Int     @id @default(autoincrement())
  uid                 String  @unique @default(cuid())
  name                String
  address             String?
  city                String?
  state               String?
  pinCode             String?
  phone               String
  email               String
  website             String?
  cin                 String
  pan                 String
  gstin               String
  epfoEstablishmentId String
  esicEmployerCode    String

  payroll_configurations payroll_configuration[]
  financial_years        financial_year[]
  salary_structures      salary_structure[]
  employees              users[]
  salary_components      salary_component[]
  payroll                payroll[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payroll_periods payroll_period[]
  roles           Role[]
}

enum PayrollCurrency {
  USD
  EUR
  GBP
  INR
  JPY
}

enum PayrollCycle {
  MONTHLY
  WEEKLY
  BI_WEEKLY
}

enum Approval {
  APPROVED
  PENDING
  REJECTED
}

enum PayrollStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum SalaryCalendar {
  CALENDAR_MONTH
  FINANCIAL_MONTH
  CUSTOM
}

model payroll_configuration {
  id                     Int             @id @default(autoincrement())
  uid                    String          @unique @default(cuid())
  company_id             String
  payroll_country        String
  currency               PayrollCurrency
  payroll_effective_date DateTime
  payroll_cycle          PayrollCycle
  working_days           Decimal         @db.Decimal(4, 2)
  attendance_cut_off     Decimal         @db.Decimal(4, 2)
  leave_cut_off          String
  overtime_cut_off       Decimal?        @db.Decimal(4, 2)
  salary_payment_date    Int
  financial_year_id      String
  salary_calendar        SalaryCalendar
  approval               Approval        @default(PENDING)
  status                 PayrollStatus
  remarks                String?

  company        company        @relation(fields: [company_id], references: [uid], onDelete: Cascade)
  financial_year financial_year @relation(fields: [financial_year_id], references: [uid], onDelete: Restrict)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payroll_periods payroll_period[]

  @@index([company_id, financial_year_id])
  @@index([company_id, status])
}

enum FinancialYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model financial_year {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  company_id String
  company    company @relation(fields: [company_id], references: [uid], onDelete: Cascade)

  name       String
  start_date DateTime            @db.Date
  end_date   DateTime            @db.Date
  status     FinancialYearStatus @default(DRAFT)

  lock Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payroll_configurations payroll_configuration[]
  payroll_periods        payroll_period[]
  employee_salary_structures employee_salary_structure[]

  @@index([company_id])
  @@index([company_id, status])
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSING
  COMPLETED
  CLOSED
}

model payroll_period {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  company_id String
  company    company @relation(fields: [company_id], references: [uid], onDelete: Cascade)

  financial_year_id String
  financial_year    financial_year @relation(fields: [financial_year_id], references: [uid], onDelete: Restrict)

  payroll_configuration_id String
  payroll_configuration    payroll_configuration @relation(fields: [payroll_configuration_id], references: [uid], onDelete: Restrict)

  period_name  String
  period_start DateTime @db.Date
  period_end   DateTime @db.Date

  salary_payment_date DateTime? @db.Date

  status PayrollPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([company_id, period_start, period_end])
  @@index([company_id])
  @@index([financial_year_id])
  @@index([payroll_configuration_id])
}

model addresses {
  id            Int       @id @default(autoincrement())
  employee_id   Int
  address_line1 String
  address_line2 String?
  city          String
  state         String
  country       String
  pincode       String
  employees     employees @relation(fields: [employee_id], references: [empid], onDelete: Cascade, onUpdate: Restrict)

  @@index([employee_id])
}

enum Status {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model attendance {
  id                Int                           @id @default(autoincrement())
  uid               String?                       @unique @default(cuid())
  empid             String
  check_in          DateTime?
  check_out         DateTime?
  total_hours       Decimal?
  date              DateTime?                     @default(now())
  created_at        DateTime?                     @default(now())
  attendance_status attendance_attendance_status? @default(Absent)
  status            Status                        @default(PENDING)
  user              users                         @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)
  regularizations   attendance_regularization[]
}

model MonthlySummary {
  id                 Int      @id @default(autoincrement())
  uid                String   @unique @default(cuid())
  empid              String
  month              Int      @db.SmallInt
  year               Int      @db.SmallInt
  total_working_days Int      @default(0)
  days_worked        Decimal  @default(0.0) @db.Decimal(5, 2)
  overtime_hours     Decimal  @default(0.0) @db.Decimal(5, 2)
  weekend            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    users   @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)

  @@unique([empid, month])
  @@index([month])
  @@index([empid])
  @@map("monthly_summary")
}

model audit_logs {
  id                                           Int        @id @default(autoincrement())
  empid                                        Int?
  performed_by                                 Int?
  action                                       String?
  timestamp                                    DateTime?  @default(now())
  employees_audit_logs_empidToemployees        employees? @relation("audit_logs_empidToemployees", fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)
  employees_audit_logs_performed_byToemployees employees? @relation("audit_logs_performed_byToemployees", fields: [performed_by], references: [empid], onUpdate: Restrict)

  @@index([empid])
  @@index([performed_by])
}

model bank_details {
  id                  Int       @id @default(autoincrement())
  employee_id         Int
  account_holder_name String
  bank_name           String
  branch_name         String?
  account_number      String
  ifsc_code           String
  checkbook_document  String?
  employees           employees @relation(fields: [employee_id], references: [empid], onDelete: Cascade, onUpdate: Restrict)

  @@index([employee_id])
}

model candidates {
  id                    Int                @id @default(autoincrement())
  candidate_id          String?            @unique
  name                  String
  email                 String
  contact_number        String?
  interview_date        DateTime?
  interview_time_from   String?
  interview_time_to     String?
  resume                String?
  form_link             String?
  created_at            DateTime?          @default(now())
  form_token            String?            @unique
  interview_mail_status String?            @default("Not Sent")
  form_status           String?            @default("Mail Not Sent")
  status                candidates_status? @default(Waiting)
  verification          Boolean?           @default(false)
  form_submitted        Boolean            @default(false)
  device_info           String?
  ip_address            String?
  token_expiry          DateTime?
  token_first_used_at   DateTime?

  parsed_resume_id  Int?               @unique
  parsed_resume     parsed_resumes?    @relation(fields: [parsed_resume_id], references: [id])
  candidate_details candidate_details?
}

model compliance_documents {
  id          Int        @id @default(autoincrement())
  empid       Int?
  doc_type    String?
  file_path   String?
  uploaded_at DateTime?  @default(now())
  expires_on  DateTime?
  employees   employees? @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)

  @@index([empid])
}

model compliance_status {
  empid          Int                               @id
  last_updated   DateTime?                         @default(now())
  overall_status compliance_status_overall_status?
  employees      employees                         @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)
}

model employees {
  empid                                         Int                    @id @default(autoincrement())
  candidate_id                                  String?
  main_employee_id                              String? // Same as users.empid
  user_empid                                    String?                @unique
  user                                          users?                 @relation(fields: [user_empid], references: [empid], onDelete: SetNull, onUpdate: Cascade)
  name                                          String?
  email                                         String?                @unique(map: "employees_email_unique")
  contact_no                                    String?
  password                                      String?
  gender                                        String?
  dob                                           DateTime?
  aadhar_card                                   String?
  pan_card                                      String?
  education_certificates                        String?
  resume                                        String?
  experience_certificate                        String?
  profile_photo                                 String?
  created_at                                    DateTime?              @default(now())
  experience_years                              Int?                   @default(0)
  experience_months                             Int?                   @default(0)
  aadhar_number                                 String?
  pan_number                                    String?
  highest_qualification                         String?
  addresses                                     addresses[]
  audit_logs_audit_logs_empidToemployees        audit_logs[]           @relation("audit_logs_empidToemployees")
  audit_logs_audit_logs_performed_byToemployees audit_logs[]           @relation("audit_logs_performed_byToemployees")
  bank_details                                  bank_details[]
  compliance_documents                          compliance_documents[]
  compliance_status                             compliance_status?

  @@index([email])
}

model candidate_details {
  id                     Int                       @id @default(autoincrement())
  candidate_id           String?
  name                   String?
  email                  String?                   @unique(map: "candidates_unique_email")
  contact_no             String?
  password               String?
  gender                 String?
  dob                    DateTime?
  aadhar_card            String?
  pan_card               String?
  education_certificates String?
  resume                 String?
  experience_certificate String?
  profile_photo          String?
  aadhar_number          String?
  pan_number             String?
  highest_qualification  String?
  addresses              candidates_addresses[]
  bank_details           candidates_bank_details[]
  created_at             DateTime?                 @default(now())
  candidates_table_id    Int?                      @unique
  candidate              candidates?               @relation(fields: [candidates_table_id], references: [id])
}

model candidates_addresses {
  id                Int               @id @default(autoincrement())
  candidate_id      Int
  address_line1     String
  address_line2     String?
  city              String
  state             String
  country           String
  pincode           String
  candidate_details candidate_details @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id])
}

model candidates_bank_details {
  id                  Int               @id @default(autoincrement())
  candidate_id        Int
  account_holder_name String
  bank_name           String
  branch_name         String?
  account_number      String
  ifsc_code           String
  checkbook_document  String?
  candidate_details   candidate_details @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id])
}

model leave_types {
  id             Int              @id @default(autoincrement())
  uid            String?          @unique @default(cuid())
  max_days       Int
  paid           Boolean?         @default(true)
  type_name      String
  leave_balances leave_balances[]
  leave_requests leave_requests[]
}

model leave_balances {
  id          Int         @id @default(autoincrement())
  empid       String
  type_id     Int
  total       Int
  used        Int?        @default(0)
  remaining   Int?
  users       users       @relation(fields: [empid], references: [empid], onUpdate: Restrict)
  leave_types leave_types @relation(fields: [type_id], references: [id], onUpdate: Restrict)

  @@index([empid])
  @@index([type_id])
}

model leave_requests {
  id               Int                    @id @default(autoincrement())
  uid              String?                @unique @default(cuid())
  empid            String
  from_date        DateTime
  to_date          DateTime
  reason           String?
  applied_at       DateTime?              @default(now())
  attachment       String?
  leave_type       String
  leave_type_id    Int?
  name             String
  status           leave_requests_status? @default(Pending)
  resoan_to_reject String?                @db.VarChar(255)
  reason_to_cancel String?                @db.VarChar(255)
  users            users                  @relation(fields: [empid], references: [empid], onDelete: Cascade, onUpdate: Restrict)
  leave_types      leave_types?           @relation(fields: [leave_type_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empid])
  @@index([leave_type_id])
}

model attendance_regularization {
  id                 Int                              @id @default(autoincrement())
  attendance_id      Int?
  empid              String
  attendance_date    DateTime
  check_in_time      DateTime
  requested_checkout DateTime
  reason             String                           @db.VarChar(500)
  status             attendance_regularization_status @default(PENDING)
  reviewed_by        String?
  reviewed_at        DateTime?
  rejection_reason   String?                          @db.VarChar(500)
  created_at         DateTime                         @default(now())
  users              users                            @relation(fields: [empid], references: [empid], onDelete: Cascade)
  attendance         attendance? @relation(fields: [attendance_id], references: [id], onDelete: SetNull)

  @@index([empid])
  @@index([attendance_id])
  @@index([status])
}

model users {
  id                         Int                              @id @default(autoincrement())
  uid                        String?                          @unique @default(cuid())
  empid                      String                           @unique
  name                       String
  email                      String                           @unique
  contact_number             String?
  password                   String
  position                   String?
  date_of_joining            DateTime?
  status                     String?                          @default("Active")
  is_active                  UserActiveStatus                 @default(ACTIVE)
  experience                 Int?
  profile_photo              String?
  created_at                 DateTime?                        @default(now())
  roleId                     Int?
  role                       users_role                       @default(employee)
  verified                   users_verified?                  @default(not_verified)
  form_submitted             Boolean                          @default(false)
  resetToken                 String?
  resetTokenExpiry           DateTime?                        @db.Timestamp(6)
  employee_type              employees_employee_type?         @default(Full_time)
  candidate_id               String?
  duration_months            Int?
  company_id                 String?
  company                    company?                         @relation(fields: [company_id], references: [uid], onDelete: SetNull)
  rbacRole                   Role?                            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  leave_balances             leave_balances[]
  leave_requests             leave_requests[]
  payroll                    payroll[]
  employee_salary_structures employee_salary_structure[]
  createdTasks               tasks[]                          @relation("TaskCreator")
  assignedTasks              tasks[]                          @relation("TaskAssignee")
  positions                  positions[]
  daily_work_reports         daily_work_reports[]
  resubmissionRequests       document_resubmission_requests[] @relation("ResubmissionEmployee")
  requestedResubmissions     document_resubmission_requests[] @relation("ResubmissionRequestor")
  attendance_regularization  attendance_regularization[]
  sessions                   session[]
  attendance       attendance[]
  monthlySummaries MonthlySummary[]
  employeeProfile  employees?
  departments                departments[]
  @@index([roleId])
  @@index([company_id])
}

model session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expiresAt    DateTime
  lastActivity DateTime @default(now())
  createdAt    DateTime @default(now())
  user         users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model payroll {
  id                Int             @id @default(autoincrement())
  empid             String?
  month             String?
  year              Int?
  basic_salary      Decimal?
  hra               Decimal?
  bonus             Decimal?        @default(0.00)
  da                Decimal?
  allowances        Decimal?
  deductions        Decimal?
  net_pay           Decimal?
  generated_on      DateTime?       @default(now())
  payslip_pdf       String?
  payslip_status    payslip_status? @default(pending)
  pf                Decimal?        @default(0.00)
  ptax              Decimal?        @default(0.00)
  esic              Decimal?        @default(0.00)
  allowance_details String?
  deduction_details String?
  company_id        String?
  company           company?        @relation(fields: [company_id], references: [uid], onDelete: SetNull)
  users             users?          @relation(fields: [empid], references: [empid], onDelete: Restrict, onUpdate: Restrict)

  @@index([empid])
  @@index([company_id])
}

enum payslip_status {
  pending
  generated
}
/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model employees_backup {
  empid                  Int       @id
  candidate_id           String?   @db.VarChar(50)
  name                   String?   @db.VarChar(100)
  email                  String?   @db.VarChar(100)
  contact_no             String?   @db.VarChar(15)
  password               String?   @db.VarChar(100)
  address                String?
  gender                 String?   @db.VarChar(10)
  dob                    DateTime? @db.Date
  aadhar_card            String?
  pan_card               String?
  education_certificates String?
  resume                 String?
  experience_certificate String?
  bank_details           String?
  profile_photo          String?
  created_at             DateTime? @default(now()) @db.Timestamp(0)
}

model calendar_events {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  event_date  DateTime
  event_type  String
  visible_to  String   @default("all")
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model contact_submissions {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model assistant_learning {
  id               Int      @id @default(autoincrement())
  question         String
  response         String
  user_id          String?  @db.VarChar(255)
  intent_category  String?  @db.VarChar(100)
  intent_labels    String?
  confidence_score Decimal? @db.Decimal(3, 2)
  frequency        Int      @default(1)
  created_at       DateTime @default(now())
  last_asked       DateTime @default(now())
}

model tasks {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.VarChar(500)
  assigned_to String
  assigned_by String
  deadline    DateTime
  priority    String   @default("Medium")
  status      String   @default("Pending")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  creator     users    @relation("TaskCreator", fields: [assigned_by], references: [empid])
  assignee    users    @relation("TaskAssignee", fields: [assigned_to], references: [empid])
}

model positions {
  id            Int      @id @default(autoincrement())
  position_name String
  description   String?
  created_by    String
  created_at    DateTime @default(now())
  users         users    @relation(fields: [created_by], references: [empid])
  department_id Int?
  department    departments? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  @@index([created_by])
}

model daily_work_reports {
  id              Int      @id @default(autoincrement())
  empid           String
  report_date     DateTime @default(now())
  tasks_completed String   @db.Text
  tasks_tomorrow  String   @db.Text
  issues          String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  users           users    @relation(fields: [empid], references: [empid], onDelete: Cascade)

  @@index([empid])
  @@index([report_date])
}

model document_resubmission_requests {
  id             Int       @id @default(autoincrement())
  employee_empid String
  document_type  String
  requested_by   String
  reason         String?
  status         String    @default("pending")
  created_at     DateTime  @default(now())
  completed_at   DateTime?
  employee       users     @relation("ResubmissionEmployee", fields: [employee_empid], references: [empid], onDelete: Cascade)
  requestor      users     @relation("ResubmissionRequestor", fields: [requested_by], references: [empid], onDelete: Cascade)

  @@index([employee_empid])
  @@index([requested_by])
}

model notifications {
  id             Int      @id @default(autoincrement())
  recipient_type String // 'user' or 'role'
  recipient_id   String // empid for user, role name for role
  title          String
  message        String   @db.Text
  type           String?
  metadata       String?  @db.Text
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())

  @@index([recipient_type, recipient_id])
  @@index([created_at])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  type        RoleType         @default(CUSTOM)
  status      RoleStatus       @default(ACTIVE)
  companyId   String?          @map("company_id")
  company     company?         @relation(fields: [companyId], references: [uid], onDelete: SetNull)
  parentId    Int?
  parent      Role?            @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Role[]           @relation("RoleHierarchy")
  users       users[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentId])
  @@index([companyId])
  @@map("roles")
}

enum RoleType {
  SUPER_ADMIN
  CUSTOM
}

enum RoleStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  name        String?
  description String?
  category    String           @default("General")
  module      String?
  action      String?
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum attendance_regularization_status {
  PENDING
  APPROVED
  REJECTED
}

enum EventType {
  holiday
  event
}

enum compliance_status_overall_status {
  Compliant
  Expiring_Soon @map("Expiring Soon")
  Non_compliant @map("Non-compliant")
}

enum leave_requests_status {
  Pending
  Approved
  Rejected
  Cancelled
}

enum attendance_attendance_status {
  Present
  Absent
  AutoCheckout
}

enum candidates_status {
  Waiting
  Pending
  Mail_Sent          @map("Mail Sent")
  Document_Submitted @map("Document Submitted")
  Selected
  Rejected
}

enum users_role {
  hr
  employee
  admin
  ceo
  superadmin
}

enum users_verified {
  verified
  not_verified @map("not verified")
}

enum employees_employee_type {
  Full_time  @map("Full-time")
  Intern
  Contractor
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryCalculationType {
  FIXED
  PERCENTAGE
  FORMULA
}

enum UserActiveStatus {
  ACTIVE
  INACTIVE
}

model salary_component {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  company_id String
  company    company @relation(fields: [company_id], references: [uid], onDelete: Cascade)

  name             String
  code             String
  type             SalaryComponentType
  calculation_type SalaryCalculationType

  taxable   Boolean @default(false)
  statutory Boolean @default(false)
  active    Boolean @default(true)
  formula   String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  structureComponents     employee_salary_structure_component[] @relation("StructureComponent")
  baseStructureComponents employee_salary_structure_component[] @relation("BaseComponent")
  employeeComponents      employee_salary_component[]

  @@unique([company_id, code])
  @@index([company_id])
}

enum SalaryStructureStatus {
  ACTIVE
  INACTIVE
}

model salary_structure {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  company_id String
  company    company @relation(fields: [company_id], references: [uid], onDelete: Cascade)

  name        String
  code        String
  description String?

  status SalaryStructureStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components               employee_salary_structure_component[]
  employeeSalaryStructures employee_salary_structure[]

  @@unique([company_id, code])
  @@index([company_id])
}

model employee_salary_structure_component {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  salary_structure_id Int
  salaryStructure     salary_structure @relation(fields: [salary_structure_id], references: [id], onDelete: Cascade)

  salary_component_id Int
  salaryComponent     salary_component @relation("StructureComponent", fields: [salary_component_id], references: [id], onDelete: Restrict)

  calculation_type SalaryCalculationType
  value            Decimal               @db.Decimal(12, 2)

  base_component_id Int?
  baseComponent     salary_component? @relation("BaseComponent", fields: [base_component_id], references: [id], onDelete: Restrict)

  sequence Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salary_structure_id, salary_component_id])
  @@index([salary_structure_id])
  @@index([salary_component_id])
  @@index([base_component_id])
}

enum EmployeeSalaryStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model employee_salary_structure {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  employee_id String
  employee    users  @relation(fields: [employee_id], references: [empid], onDelete: Cascade)

  salary_structure_id String
  salaryStructure     salary_structure @relation(fields: [salary_structure_id], references: [uid], onDelete: Restrict)

  financial_year_id String
  financialYear     financial_year  @relation(fields: [financial_year_id], references: [uid], onDelete: Cascade)

  status EmployeeSalaryStatus @default(ACTIVE)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components employee_salary_component[]

  @@index([employee_id])
  @@index([salary_structure_id])
  @@index([financial_year_id])
  @@index([status])
}

model employee_salary_component {
  id  Int    @id @default(autoincrement())
  uid String @unique @default(cuid())

  employee_salary_structure_id Int
  employeeSalaryStructure      employee_salary_structure @relation(fields: [employee_salary_structure_id], references: [id], onDelete: Cascade)

  salary_component_id Int
  salaryComponent     salary_component @relation(fields: [salary_component_id], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employee_salary_structure_id, salary_component_id])
  @@index([employee_salary_structure_id])
  @@index([salary_component_id])
}

model parsed_resumes {
  id               Int     @id @default(autoincrement())
  uid              String  @unique @default(uuid())
  // Personal
  full_name        String?
  email            String?
  mobile_number    String?
  alternate_phone  String?
  current_address  String?
  city             String?
  state            String?
  country          String?
  linkedin_profile String?
  portfolio_url    String?
  github_url       String?

  // Professional
  career_objective     String? @db.Text
  professional_summary String? @db.Text

  // Structured JSON fields
  work_experience         Json?
  education               Json?
  technical_skills        Json?
  soft_skills             Json?
  certifications          Json?
  languages_known         Json?
  projects                Json?
  awards_and_achievements Json?
  publications            Json?
  training                Json?

  // Additional info
  notice_period      String?
  current_salary     String?
  expected_salary    String?
  preferred_location String?
  resume_file_path   String?
  original_file_name String?
  resume_mime_type   String?
  resume_file_size   Int?

  // Parser processing metadata
  parsing_status     String?  @default("PROCESSING")
  parser_version     String?
  ai_model           String?
  application_status String   @default("Waiting")
  parsing_error      String?  @db.Text
  parsed_at          DateTime @default(now())
  updated_at         DateTime @updatedAt

  //
  job_description_id Int?
  matching_score     Int?

  job_description job_descriptions? @relation(fields: [job_description_id], references: [id], onDelete: SetNull)

  candidate candidates?

  @@index([job_description_id])
}

model job_descriptions {
  id                Int                       @id @default(autoincrement())
  uid               String                    @unique @default(uuid())
  title             String
  department        String 
  employment_type   String
  work_mode         String
  location          String
  openings          Int
  experience        String
  education         String
  required_skills   String                    @db.Text
  preferred_skills  String?                   @db.Text
  responsibilities  String                    @db.Text
  summary           String                    @db.Text
  salary_min        String?
  salary_max        String?
  benefits          String?                   @db.Text
  deadline          DateTime
  hiring_manager    String
  interview_process String?                   @db.Text
  keywords          String?
  status            String                    @default("Draft")
  created_by        String?
  created_at        DateTime                  @default(now())
  updated_at        DateTime                  @updatedAt
  analysis          job_description_analysis?
  parsed_resumes    parsed_resumes[]
}

model job_description_analysis {
  id                 Int    @id @default(autoincrement())
  uid                String @unique @default(uuid())
  job_description_id Int    @unique

  // Job Information
  job_title           String?
  department          String?
  employment_type     String?
  work_mode           String?
  location            String?
  experience_required String?
  education           String?
  salary_min          String?
  salary_max          String?
  openings            Int?

  // Skills
  mandatory_skills Json?
  preferred_skills Json?
  soft_skills      Json?

  // Keywords
  technical_keywords  Json?
  functional_keywords Json?
  industry_keywords   Json?
  role_keywords       Json?

  // Experience
  minimum_experience  String?
  maximum_experience  String?
  industry_experience Json?
  domain_expertise    Json?

  // Education
  degree                   Json?
  stream                   Json?
  certifications           Json?
  mandatory_certifications Json?
  preferred_certifications Json?

  // Responsibilities
  primary_responsibilities    Json?
  secondary_responsibilities  Json?
  leadership_responsibilities Json?

  // Quality
  quality_score Int?

  completeness_score Int?
  readability_score  Int?
  ats_score          Int?
  bias_free_score    Int?
  keyword_score      Int?

  // Missing information
  missing_information Json?

  // Bias
  bias_detected         Boolean @default(false)
  bias_details          Json?
  inclusive_suggestions Json?

  // ATS
  ats_suggestions Json?

  // Matching
  required_skills_weight Int?
  experience_weight      Int?
  education_weight       Int?
  certification_weight   Int?

  matching_criteria Json?

  // AI metadata
  analysis_status  String   @default("PENDING")
  confidence_score Decimal? @db.Decimal(5, 2)
  ai_model         String?
  analysis_error   String?  @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  job_description job_descriptions @relation(fields: [job_description_id], references: [id], onDelete: Cascade)

  @@index([analysis_status])
}

model departments {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  created_by  String
  created_at  DateTime    @default(now())
  users       users       @relation(fields: [created_by], references: [empid])
  positions   positions[]

  @@index([created_by])
}
